# C-OS 4.1.0 Makefile - 64-bit Build
.DEFAULT_GOAL := iso

# Build with: make
# Requires: gcc (x86_64), nasm, ld, grub-mkrescue, xorriso

# ---- Toolchain ----
CC      = gcc
CXX     = g++
AS      = nasm
LD      = ld
OBJCOPY = objcopy
