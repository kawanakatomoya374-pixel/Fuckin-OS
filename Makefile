# A real Wikipedia article, embedded for the boot-time HTML/CSS/DOM/
# layout stress test (COS_VALIDATION_HTML_STRESS in kernel.c). -O0
# override: this is a ~745KB byte-array initializer, and -O2 makes gcc
# spend a genuinely long time constant-folding an array this large for
# no benefit - it is opaque data, not code to optimize.
$(OBJ_DIR)/assets/wiki_stress_page.o: $(SRCROOT)/assets/wiki_stress_page.c | $(OBJ_DIR)
	mkdir -p $(dir $@)
	$(CC) $(filter-out -O2,$(CFLAGS)) -O0 $(INCLUDES) -c $< -o $@

$(OBJ_DIR)/drivers/input/mouse.o: $(SRCROOT)/drivers/input/mouse.c | $(OBJ_DIR)
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Validation-only: fs.c seeds the browser self-test document when
# BROWSER_FILE_SMOKE=1, so regenerate the embedded fixture header first.
BROWSER_SMOKE_FIXTURE_SRC ?= validation/browser/quickjs_dom_eventtarget_style_selftest.html
BROWSER_SMOKE_FIXTURE_HDR := build/browser_smoke_fixture.h

$(BROWSER_SMOKE_FIXTURE_HDR): $(BROWSER_SMOKE_FIXTURE_SRC) tools/gen_browser_fixture.py | $(BUILD_DIR)
	@python3 tools/gen_browser_fixture.py --in $< --out $@

ifeq ($(BROWSER_FILE_SMOKE),1)
FS_FIXTURE_DEP := $(BROWSER_SMOKE_FIXTURE_HDR)
else
FS_FIXTURE_DEP :=
endif

$(OBJ_DIR)/fs/fs.o: $(SRCROOT)/fs/fs.c $(FS_FIXTURE_DEP) | $(OBJ_DIR)
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

