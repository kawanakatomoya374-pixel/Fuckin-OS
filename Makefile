# fileserver.c-os / fileclient.c-os: the first REAL userspace server this
# tree ships, proving SYS_IPC_* (see docs/STACK_OVERFLOW_INVESTIGATION.md
# section 10) end to end through the actual syscall boundary between two
# independently-scheduled processes, not a kernel thread calling
# ipc_send()/ipc_receive() directly the way COS_VALIDATION_IPC_TEST does.
# Built the same way as every other program here: compiled once with
# cos-cc into a checked-in .c-os binary, then embedded as a byte array at
# build time via the same tool that generates every other one in this
# list, so a fresh checkout needs no cross-compilation step to reproduce
# the header.
#
# Source and pre-built binary live under Server/ - the project's actual
# userspace servers, kept separate from validation/cos_programs/ (which
# is test fixtures for the ELF loader itself: argv handling, mmap,
# signals, cross-library relocation - not real services). A server that
# happens to double as this session's IPC-syscall proof still belongs in
# Server/, not in the loader's own test fixture directory.
COS_SERVER_DIR := Server
VALIDATION_HEADERS += $(BUILD_DIR)/cos_fileserver_elf.h
$(BUILD_DIR)/cos_fileserver_elf.h: $(COS_SERVER_DIR)/fileserver/fileserver.c-os tools/gen_cos_program.py | $(BUILD_DIR)
	@mkdir -p $(BUILD_DIR)
	python3 tools/gen_cos_program.py --in $(COS_SERVER_DIR)/fileserver/fileserver.c-os --out $(BUILD_DIR)/cos_fileserver_elf.h --symbol cos_fileserver_elf

VALIDATION_HEADERS += $(BUILD_DIR)/cos_fileclient_elf.h
$(BUILD_DIR)/cos_fileclient_elf.h: $(COS_SERVER_DIR)/testclients/fileclient.c-os tools/gen_cos_program.py | $(BUILD_DIR)
	@mkdir -p $(BUILD_DIR)
	python3 tools/gen_cos_program.py --in $(COS_SERVER_DIR)/testclients/fileclient.c-os --out $(BUILD_DIR)/cos_fileclient_elf.h --symbol cos_fileclient_elf

# nx_probe.c-os: deliberately executes a `ret` instruction written into
# its own heap, to PROVE the NX fix in task_handle_page_fault() (task.c)
# actually stops execution from writable process memory, rather than
# merely observing that nothing else broke. See the file's own header
# for exactly what a pass/fail looks like in the kernel serial log.
VALIDATION_HEADERS += $(BUILD_DIR)/cos_nx_probe_elf.h
$(BUILD_DIR)/cos_nx_probe_elf.h: $(COS_SERVER_DIR)/testclients/nx_probe.c-os tools/gen_cos_program.py | $(BUILD_DIR)
	@mkdir -p $(BUILD_DIR)
	python3 tools/gen_cos_program.py --in $(COS_SERVER_DIR)/testclients/nx_probe.c-os --out $(BUILD_DIR)/cos_nx_probe_elf.h --symbol cos_nx_probe_elf

# hello_app.c-os: the first real, standalone .c-os GUI application - see
# Server/apps/hello_app.c's own header for what it demonstrates. Embedded
# here the same way every boot-time validation program is (a checked-in
# prebuilt binary, turned into a byte array at kernel-build time), but
# spawned differently: written to the REAL FAT32 volume via
# cos_write_file() at boot (spawn_cos_hello_app_test(),
# userspace_demo.c) and then launched via cos_spawn_elf_path_args()
# reading that path - the same on-disk spawn path diskhello.c-os already
# exercises - rather than cos_launch_elf_image()'s embedded-image path
# every other program here uses. That distinction matters: an app
# spawned from a real file is exactly the shape "replace a built-in
# kernel app with a real userspace program, launchable on demand" needs,
# even though the bytes still originate from this kernel image today -
# see Server/README.md for the fuller reasoning and what remains to make
# the app itself not need to be embedded at all.
VALIDATION_HEADERS += $(BUILD_DIR)/cos_hello_app_elf.h
$(BUILD_DIR)/cos_hello_app_elf.h: $(COS_SERVER_DIR)/apps/hello_app.c-os tools/gen_cos_program.py | $(BUILD_DIR)
	@mkdir -p $(BUILD_DIR)
	python3 tools/gen_cos_program.py --in $(COS_SERVER_DIR)/apps/hello_app.c-os --out $(BUILD_DIR)/cos_hello_app_elf.h --symbol cos_hello_app_elf

$(OBJ_DIR)/kernel/userspace_demo.o: $(VALIDATION_HEADERS)

# ============================================================================
# Userland runtime for .c-os programs
# ----------------------------------------------------------------------------
# crt0 + libcos.a, which tools/cos-cc links external programs against.
#
# This was never in the Makefile before. userland/lib/ existed and was
# referenced by the documentation, but nothing built it - and cos_crt0.S was
# NASM source in a file named `.S`, which the compiler driver assembles as
# GAS, so it could not have been built by an ordinary rule even if one had
# existed. It is GAS syntax now and builds with the driver like any other
# source file.
#
# Built with the HOST compiler rather than $(CC): these are ring3 objects for
# the same architecture, and they must NOT pick up the kernel's freestanding
# flags (no red zone, kernel code model, etc.), which would be wrong for user
# code and in the -mcmodel case actively break a PIE.
USERLAND_DIR   := userland
USERLAND_BUILD := $(BUILD_DIR)/userland
USERLAND_CC    ?= gcc
USERLAND_AR    ?= ar
USERLAND_CFLAGS := -ffreestanding -nostdlib -fstack-protector-strong -mstack-protector-guard=global -fno-builtin \
                   -fno-asynchronous-unwind-tables -fPIC -O2 \
                   -I$(USERLAND_DIR)/include

USERLAND_OBJS := $(USERLAND_BUILD)/cos_lib.o  $(USERLAND_BUILD)/cos_posix.o $(USERLAND_BUILD)/cos_rtld.o $(USERLAND_BUILD)/cos_plugin.o $(USERLAND_BUILD)/cos_plugin_base.o \
                 $(USERLAND_BUILD)/cos_fmt.o  $(USERLAND_BUILD)/cos_math.o \
                 $(USERLAND_BUILD)/cos_sync.o $(USERLAND_BUILD)/cos_libc.o \
                 $(USERLAND_BUILD)/cos_ui.o $(USERLAND_BUILD)/cos_ui_fonts.o \
                 $(USERLAND_BUILD)/cos_widget.o

# The standard C library layer (<stdio.h>, <stdlib.h>, ... in
# userland/include/libc). Built with -nostdinc so it can never pick up the
# host's glibc headers - exactly what tools/cos-cc does for programs.
USERLAND_GCC_INC := $(shell $(USERLAND_CC) -print-file-name=include)
# cos_ui: drawing + TrueType text for ring-3 apps (stb_truetype, embedded DejaVu subsets)
$(USERLAND_BUILD)/cos_ui.o: $(USERLAND_DIR)/lib/cos_ui.c $(USERLAND_DIR)/include/cos_ui.h $(USERLAND_DIR)/third_party/stb_truetype.h | $(USERLAND_BUILD)
	$(USERLAND_CC) $(USERLAND_CFLAGS) -Wno-unused-function -nostdinc -isystem $(USERLAND_GCC_INC) -isystem $(USERLAND_DIR)/include/libc -c $< -o $@
$(USERLAND_BUILD)/cos_widget.o: $(USERLAND_DIR)/lib/cos_widget.c $(USERLAND_DIR)/include/cos_widget.h $(USERLAND_DIR)/include/cos_ui.h $(USERLAND_DIR)/include/cos.h | $(USERLAND_BUILD)
	$(USERLAND_CC) $(USERLAND_CFLAGS) $(if $(CW_DEBUG),-DCW_DEBUG) -nostdinc -isystem $(USERLAND_GCC_INC) -isystem $(USERLAND_DIR)/include/libc -c $< -o $@
$(USERLAND_BUILD)/cos_ui_fonts.o: $(USERLAND_DIR)/lib/cos_ui_fonts.c | $(USERLAND_BUILD)
	$(USERLAND_CC) $(USERLAND_CFLAGS) -nostdinc -isystem $(USERLAND_GCC_INC) -c $< -o $@

$(USERLAND_BUILD)/cos_libc.o: $(USERLAND_DIR)/lib/cos_libc.c $(wildcard $(USERLAND_DIR)/include/libc/*.h) | $(USERLAND_BUILD)
	$(USERLAND_CC) $(USERLAND_CFLAGS) -nostdinc -isystem $(USERLAND_GCC_INC) -c $< -o $@

$(USERLAND_BUILD)/cos_posix.o: $(USERLAND_DIR)/lib/cos_posix.c $(wildcard $(USERLAND_DIR)/include/libc/*.h $(USERLAND_DIR)/include/libc/*/*.h) | $(USERLAND_BUILD)
	$(USERLAND_CC) $(USERLAND_CFLAGS) -nostdinc -isystem $(USERLAND_GCC_INC) -isystem $(USERLAND_DIR)/include/libc -c $< -o $@
	nm --defined-only -g $@ | awk 'NF==3 {print $$3}' > $@.weak && objcopy --weaken-symbols=$@.weak $@ && rm -f $@.weak     # defined names only: weakening the undefined ones would leave them unresolved (null) instead of pulling libcos members. Programs with their own open/pthread_* (tcc_shim, the media decoders) keep theirs instead of clashing with this layer

$(USERLAND_BUILD)/cos_fmt.o: $(USERLAND_DIR)/lib/cos_fmt.c | $(USERLAND_BUILD)
	$(USERLAND_CC) $(USERLAND_CFLAGS) -c $< -o $@

$(USERLAND_BUILD)/cos_math.o: $(USERLAND_DIR)/lib/cos_math.c | $(USERLAND_BUILD)
	$(USERLAND_CC) $(USERLAND_CFLAGS) -c $< -o $@

$(USERLAND_BUILD)/cos_sync.o: $(USERLAND_DIR)/lib/cos_sync.c | $(USERLAND_BUILD)
	$(USERLAND_CC) $(USERLAND_CFLAGS) -c $< -o $@

$(USERLAND_BUILD):
	mkdir -p $@

$(USERLAND_BUILD)/cos_lib.o: $(USERLAND_DIR)/lib/cos_lib.c | $(USERLAND_BUILD)
	$(USERLAND_CC) $(USERLAND_CFLAGS) -c $< -o $@

$(USERLAND_BUILD)/cos_rtld.o: $(USERLAND_DIR)/lib/cos_rtld.c | $(USERLAND_BUILD)
	$(USERLAND_CC) $(USERLAND_CFLAGS) -c $< -o $@

$(USERLAND_BUILD)/cos_plugin.o: $(USERLAND_DIR)/lib/cos_plugin.c $(USERLAND_DIR)/include/cos_plugin.h | $(USERLAND_BUILD)
	$(USERLAND_CC) $(USERLAND_CFLAGS) -c $< -o $@

$(USERLAND_BUILD)/cos_plugin_base.o: $(USERLAND_DIR)/lib/cos_plugin_base.c $(USERLAND_DIR)/include/cos_plugin_base.h | $(USERLAND_BUILD)
	$(USERLAND_CC) $(USERLAND_CFLAGS) -c $< -o $@

$(USERLAND_BUILD)/cos_crt0.o: $(USERLAND_DIR)/lib/cos_crt0.S | $(USERLAND_BUILD)
	$(USERLAND_CC) -c $< -o $@

$(USERLAND_BUILD)/libcos.a: $(USERLAND_OBJS)
	$(USERLAND_AR) rcs $@ $(USERLAND_OBJS)

.PHONY: userland
userland: $(USERLAND_BUILD)/cos_crt0.o $(USERLAND_BUILD)/libcos.a
	@echo "[userland] runtime built; build programs with: tools/cos-cc -o prog.c-os prog.c"

# ============================================================================
# ELF loader conformance tests
# ----------------------------------------------------------------------------
# Compiles src/kernel/cos_elf.c and cos_elf_link.c UNMODIFIED against a
# simulated MMU and runs them over binaries produced by the host toolchain -
# static, PIE, DT_RELR, PT_TLS, ifunc, versioned symbols, a real dependency
# graph, and a program built through tools/cos-cc exactly as a user would.
#
# Runs on the host and needs nothing but gcc, so it is cheap enough to run on
# every change to the loader. It found three real bugs in this rewrite before
# any of it reached the kernel.
.PHONY: check-elfloader
check-elfloader:
	sh validation/elfloader/run.sh

# Host tests for the .c-os C runtime: the formatter and math library
# compared DIFFERENTIALLY against the host libc/libm (including 80,000
# randomised inputs), and the lock primitives under real concurrent host
# threads forwarding to the real Linux futex.
#
# Differential rather than golden because a golden test only proves the
# formatter agrees with what its author believed C99 says - and the
# corners are exactly where the author is wrong. It caught an exp() that
# returned infinity above 693 (a broken ldexp step), a %f that rounded
# ties the wrong way, and a %g that never stripped trailing zeros from
# its scientific form.
.PHONY: check-userland
check-userland:
	sh validation/userland/run.sh

# CSS-aware text metrics and glyph synthesis (src/netsurf/cos_ns_font.c),
# against a stub glyph driver whose fake font has ink on every row and
# edge column - so a resampling bug shows up as wrong ink, not silence.
# Protects geometry (font-size becomes real pixels; measurement used by
# layout and drawing used by the text plotter agree on every advance),
# not glyph beauty.
.PHONY: check-nsfont
check-nsfont:
	sh validation/nsfont/run.sh

# NOT named `check`: that target already exists for the full kernel build
# (Makefile:1912) and silently redefining it would replace a real build
# verification with host test suites that never touch the kernel.
.PHONY: check-host
check-host: check-elfloader check-userland check-nsfont
	@echo "[check-host] loader, linker, formatter, math, locks and NetSurf font metrics all green"

.PHONY: hdd

# Sprint's examples and its icon as an app pack for C-OS Apps (the interpreter itself is in the OS image, /bin/sprint.c-os). Double-clicking a .sp file runs it.
SPRINT_PACK_OUT ?= $(BUILD_DIR)/appsite/apps/sprint
sprint-pack:
	rm -rf $(BUILD_DIR)/sprintpack_src && mkdir -p $(BUILD_DIR)/sprintpack_src
	cp ports/sprint/pack/* $(BUILD_DIR)/sprintpack_src/
	python3 tools/app_pack.py $(BUILD_DIR)/sprintpack_src $(SPRINT_PACK_OUT) --id sprint --title Sprint --version 2
	echo "Sprint, a small scripting language with a GUI library (part of C-OS). Examples for /apps/sprint; double-click a .sp file to run it." > $(SPRINT_PACK_OUT)/about.txt
.PHONY: sprint-pack

# PSXFunkin (ports/psxfunkin) as an app pack: the game, the data setup program and its recipe (a list of names and SHA-256, no game assets). UP = the PSXFunkin tree.
PSX_PACK_OUT ?= $(BUILD_DIR)/appsite/apps/psxfunkin
psx-pack: $(BUILD_DIR)/libbearssl_user.a
	rm -rf $(BUILD_DIR)/psxpack_src && mkdir -p $(BUILD_DIR)/psxpack_src/setup
	ports/psxfunkin/cos/build_cos.sh $(CURDIR)/$(BUILD_DIR)/psxpack_src/psxfunkin.c-os
	ports/psxfunkin/setup/build_cos.sh $(CURDIR)/$(BUILD_DIR)/psxpack_src/setup/psxsetup.c-os
	cp ports/psxfunkin/setup/data/* $(BUILD_DIR)/psxpack_src/setup/
	cp ports/psxfunkin/pack/icon.png $(BUILD_DIR)/psxpack_src/icon.png
	python3 tools/app_pack.py $(BUILD_DIR)/psxpack_src $(PSX_PACK_OUT) --id psxfunkin --title PSXFunkin --exec psxfunkin.c-os --version 0.2
	echo "PSXFunkin: Friday Night Funkin' for the PlayStation (MPL-2.0, github.com/IgorSou3000/PSXFunkin) ported to C-OS. The first start downloads the game data from the PSXFunkin repository on GitHub and prepares it (about 71 MB)." > $(PSX_PACK_OUT)/about.txt
.PHONY: psx-pack
