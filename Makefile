	tools/cos-cc -O2 -DM_PI=3.14159265358979323846 -include stdio.h -I$(TINYGL_DIR)/include -I$(TINYGL_SRC_DIR) -o $@ userland/programs/tinygl/main.c userland/programs/tinygl/gl_mem.c $(TINYGL_USER_SRCS)
