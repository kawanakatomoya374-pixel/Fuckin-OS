# ============================================================================
# Host toolchain detection and preflight check
# ----------------------------------------------------------------------------
# grub-mkrescue is named grub2-mkrescue on Fedora/RHEL/openSUSE and
# grub-mkrescue on Debian/Ubuntu/Arch. It was previously hardcoded as
# grub-mkrescue with no fallback and no existence check, so on an RPM-based
# distro the entire build ran to completion and then failed at the very last
# step with a bare "grub-mkrescue: command not found" - after several minutes
# of compiling, with nothing indicating that the tool simply has a different
# name there.
GRUB_MKRESCUE := $(shell command -v grub-mkrescue 2>/dev/null || command -v grub2-mkrescue 2>/dev/null)

# Every host tool the build actually invokes. Checked up front by the
# check-tools target (a prerequisite of the default target) so a missing
# tool is reported immediately, by name, with an install hint - instead of
# surfacing minutes later as a cryptic "command not found" from deep inside
# a recipe, or (worse) as a confusing downstream compile error caused by a
# generated file that never got generated.
REQUIRED_TOOLS := gcc ld nasm objcopy ar python3 xorriso

.PHONY: check-tools
check-tools:
	@missing=""; \
	for t in $(REQUIRED_TOOLS); do \
		command -v $$t >/dev/null 2>&1 || missing="$$missing $$t"; \
	done; \
	if [ -z "$(GRUB_MKRESCUE)" ]; then missing="$$missing grub-mkrescue(or grub2-mkrescue)"; fi; \
	if [ -n "$$missing" ]; then \
		echo ""; \
		echo "[BUILD] ERROR: required host tools are missing:$$missing"; \
		echo ""; \
		echo "[BUILD]   Debian/Ubuntu: sudo apt install build-essential nasm python3 \\"; \
		echo "[BUILD]                    xorriso grub-pc-bin grub-efi-amd64-bin mtools"; \
		echo "[BUILD]   Fedora/RHEL:   sudo dnf install gcc binutils nasm python3 \\"; \
		echo "[BUILD]                    xorriso grub2-tools grub2-efi-x64 mtools"; \
		echo "[BUILD]   Arch:          sudo pacman -S base-devel nasm python xorriso grub mtools"; \
		echo ""; \
		exit 1; \
	fi
SRCROOT := $(if $(wildcard src/boot/linker.ld),src,.)

# make does not see changes to command-line variables (VALIDATION_OPEN_*=1 ...), so objects whose
# source reads those macros would silently keep the old behaviour - which is why switching a validation
# flag used to need `touch`/`make -B`. Track the full flag string in a stamp and make exactly those
# objects depend on it.
KERNEL_FLAG_STAMP := $(BUILD_DIR)/kernel_flags.stamp
$(call track_flags,$(KERNEL_FLAG_STAMP),$(CFLAGS))
KERNEL_FLAG_SRCS := $(shell grep -rlE 'COS_(VALIDATION|SCHED_PREEMPTION|STRESS_TEST|BROWSER_SMOKE|HTTP_RUNTIME|BROWSER_FILE)' $(SRCROOT) --include=*.c 2>/dev/null)
$(patsubst $(SRCROOT)/%.c,$(OBJ_DIR)/%.o,$(KERNEL_FLAG_SRCS)): $(KERNEL_FLAG_STAMP)

KERNEL    = kernel.elf
ISO       = C-OS_4.0.9_alpha.iso
