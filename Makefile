# Ported (not hand-written) FFmpeg WebP/VP8 decoder - see
# src/third_party/ffmpeg_webp/CPORT_README.md for what this is and the
# scope it deliberately stops at. WEBP_INCLUDES adds this directory (for
# the flat compat headers like avcodec.h) and its libavutil/ subdirectory
# (so "libavutil/foo.h" quote-includes from the ported .c files resolve)
# ahead of the kernel's own normal INCLUDES.
WEBP_INCLUDES = -Isrc/third_party/ffmpeg_webp -Isrc/third_party/ffmpeg_webp/libavutil

$(OBJ_DIR)/third_party/ffmpeg_webp/vlc.o: $(SRCROOT)/third_party/ffmpeg_webp/vlc.c | $(OBJ_DIR)
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(WEBP_INCLUDES) $(INCLUDES) -c $< -o $@

$(OBJ_DIR)/third_party/ffmpeg_webp/vp8dsp.o: $(SRCROOT)/third_party/ffmpeg_webp/vp8dsp.c | $(OBJ_DIR)
