# C-OS 4.0.8 alpha Makefile - 64-bit Build
.DEFAULT_GOAL := iso

# Build with: make
# Requires: gcc (x86_64), nasm, ld, grub-mkrescue, xorriso

# ---- Toolchain ----
CC      = gcc
CXX     = g++
AS      = nasm
LD      = ld
OBJCOPY = objcopy
GO      = go
PACK_STORAGE = $(BUILD_DIR)/pack_storage
COSNET = $(BUILD_DIR)/cosnet
COSNET_STATE = $(BUILD_DIR)/cosnet_state.h
TEXT_BROWSER = $(BUILD_DIR)/text_browser

# ---- Compiler flags (optimized 64-bit freestanding) ----
# A dedicated validation image may enable the in-guest HTTP/2+Brotli smoke
# worker. Production/normal Secure Boot artifacts remain at 0 by default.
HTTP_RUNTIME_SMOKE ?= 0
# Loads the storage-backed local QuickJS document as the Browser start page in
# validation-only media. Normal artifacts remain at 0.
BROWSER_FILE_SMOKE ?= 0

# The boot-time HTML/CSS/DOM/layout stress test (see kernel.c's
# COS_VALIDATION_HTML_STRESS). Its input asset,
# src/assets/wiki_stress_page.c, is a ~4.6 MB generated byte-array of a
# real Wikipedia article and is NOT kept in version control - regenerate
# it with tools/gen_stress_asset.sh.
#
# The object is therefore linked in ONLY when the test is enabled.
# Listing it unconditionally made an ordinary `make` fail outright with
# "No rule to make target 'src/assets/wiki_stress_page.c'" on any tree
# that did not happen to have the generated file sitting there - which
# is every fresh checkout.
VALIDATION_HTML_STRESS ?= 0
# When BROWSER_FILE_SMOKE=1, tests may override this with any public HTTPS URL
# (for example https://www.google.com/) without changing browser source code.
BROWSER_SMOKE_START_URL ?= file:///browser/index.html
CFLAGS  = -m64 -ffreestanding -nostdlib -fno-stack-protector -O0 -g \
          	-DCOS_LUA_LINKED=1 -DCOS_HTTP_RUNTIME_SMOKE=$(HTTP_RUNTIME_SMOKE) \
          	-DCOS_BROWSER_FILE_SMOKE=$(BROWSER_FILE_SMOKE) \
          	-DCOS_VALIDATION_OPEN_FILE_MANAGER=$(if $(VALIDATION_OPEN_FILE_MANAGER),$(VALIDATION_OPEN_FILE_MANAGER),0) \
          	-DCOS_VALIDATION_LAUNCH_TEST_APP=$(if $(VALIDATION_LAUNCH_TEST_APP),$(VALIDATION_LAUNCH_TEST_APP),0) \
          	-DCOS_VALIDATION_SUITE=$(if $(VALIDATION_SUITE),$(VALIDATION_SUITE),0) \
          	-DCOS_VALIDATION_HTML_STRESS=$(if $(VALIDATION_HTML_STRESS),$(VALIDATION_HTML_STRESS),0) \
          	-DCOS_VALIDATION_GUARD_PAGE_TEST=$(if $(VALIDATION_GUARD_PAGE_TEST),$(VALIDATION_GUARD_PAGE_TEST),0) \
          	-DCOS_VALIDATION_HEAP_EXTENSION_TEST=$(if $(VALIDATION_HEAP_EXTENSION_TEST),$(VALIDATION_HEAP_EXTENSION_TEST),0) \
          	-DCOS_VALIDATION_IPC_TEST=$(if $(VALIDATION_IPC_TEST),$(VALIDATION_IPC_TEST),0) \
          	-DCOS_VALIDATION_FILESERVER_TEST=$(if $(VALIDATION_FILESERVER_TEST),$(VALIDATION_FILESERVER_TEST),0) \
          	-DCOS_VALIDATION_NX_PROBE=$(if $(VALIDATION_NX_PROBE),$(VALIDATION_NX_PROBE),0) \
          	-DCOS_VALIDATION_HELLO_APP_TEST=$(if $(VALIDATION_HELLO_APP_TEST),$(VALIDATION_HELLO_APP_TEST),0) \
          	-DCOS_VALIDATION_FORCE_GPU_RENDER=$(if $(VALIDATION_FORCE_GPU_RENDER),$(VALIDATION_FORCE_GPU_RENDER),0) \
          	-DCOS_VALIDATION_OPEN_IMAGE_VIEWER=$(if $(VALIDATION_OPEN_IMAGE_VIEWER),$(VALIDATION_OPEN_IMAGE_VIEWER),0) \
          	-DCOS_VALIDATION_CREATE_APP_FOLDER=$(if $(VALIDATION_CREATE_APP_FOLDER),$(VALIDATION_CREATE_APP_FOLDER),0) \
          	-DCOS_VALIDATION_OPEN_SETTINGS_SCROLL_TEST=$(if $(VALIDATION_OPEN_SETTINGS_SCROLL_TEST),$(VALIDATION_OPEN_SETTINGS_SCROLL_TEST),0) \
          	-DCOS_VALIDATION_OPEN_BROWSER_TEST=$(if $(VALIDATION_OPEN_BROWSER_TEST),$(VALIDATION_OPEN_BROWSER_TEST),0) \
          	-DCOS_VALIDATION_FORCE_XS_FONT=$(if $(VALIDATION_FORCE_XS_FONT),$(VALIDATION_FORCE_XS_FONT),0) \
          	-DCOS_VALIDATION_VIRGL_SELFTEST=$(if $(VALIDATION_VIRGL_SELFTEST),$(VALIDATION_VIRGL_SELFTEST),0) \
          	-DCOS_VALIDATION_VIRGL_GPU_FILL=$(if $(VALIDATION_VIRGL_GPU_FILL),$(VALIDATION_VIRGL_GPU_FILL),0) \
          	-DCOS_VALIDATION_VIRGL_ALPHA_PROBE=$(if $(VALIDATION_VIRGL_ALPHA_PROBE),$(VALIDATION_VIRGL_ALPHA_PROBE),0) \
          	-DCOS_VALIDATION_GPU_ROUNDTRIP=$(if $(VALIDATION_GPU_ROUNDTRIP),$(VALIDATION_GPU_ROUNDTRIP),0) \
          	-DCOS_VALIDATION_USER_ELF=$(if $(strip $(VALIDATION_USER_ELF)),1,0) \
          	-DCOS_VALIDATION_SANDBOX_CA=$(if $(VALIDATION_SANDBOX_CA),$(VALIDATION_SANDBOX_CA),0) \
          	-DCOS_VALIDATION_AUDIO_TEST=$(if $(VALIDATION_AUDIO_TEST),$(VALIDATION_AUDIO_TEST),0) \
          	-DCOS_VALIDATION_MUSIC_OPEN=$(if $(VALIDATION_MUSIC_OPEN),$(VALIDATION_MUSIC_OPEN),0) \
          	-DCOS_VALIDATION_GPU_FULL_SETTINGS=$(if $(VALIDATION_GPU_FULL_SETTINGS),$(VALIDATION_GPU_FULL_SETTINGS),0) \
          	-DCOS_VALIDATION_GPU_FINISH=$(if $(VALIDATION_GPU_FINISH),$(VALIDATION_GPU_FINISH),0) \
          	-DCOS_VALIDATION_MULTI_LAUNCH=$(if $(VALIDATION_MULTI_LAUNCH),$(VALIDATION_MULTI_LAUNCH),0) \
          	-DCOS_VALIDATION_LAUNCH_TEST_APP_EMBEDDED=$(if $(VALIDATION_LAUNCH_TEST_APP_EMBEDDED),$(VALIDATION_LAUNCH_TEST_APP_EMBEDDED),0) \
          	-DCOS_VALIDATION_BROWSER_URL=$(if $(VALIDATION_BROWSER_URL),$(VALIDATION_BROWSER_URL),0) \
          	-DCOS_SCHED_PREEMPTION_PROBE=$(if $(SCHED_PREEMPTION_PROBE),$(SCHED_PREEMPTION_PROBE),0) \
          	$(if $(STRESS_TEST_STACK_MB),-DCOS_STRESS_TEST_STACK_SIZE='($(STRESS_TEST_STACK_MB)u * 1024u * 1024u)',) \
          	-DCOS_BROWSER_SMOKE_START_URL=\"$(BROWSER_SMOKE_START_URL)\" \
	-Isrc/fs \
	-fno-pic -fno-pie -fno-strict-aliasing -fno-builtin -mcmodel=kernel \
	-mno-red-zone -msse2 -mfpmath=sse \
	-O2 -Wall -Wextra -Wno-unused-parameter \
	-Wno-unused-function -Wno-sign-compare \
	-Ibuild -Ibuild/genhdr \
	-U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0 \
	-D__x86_64__ -D__LP64__ -DCOS_KERNEL -DCOS_ENABLE_FULL_DESKTOP=1 \
	-DBR_RDRAND=0 -DBR_USE_URANDOM=0 -DBR_USE_UNIX_TIME=0 -DBR_USE_WIN32_RAND=0 -DBR_USE_WIN32_TIME=0 \
	-MMD -MP

