# ---- Directories ----
OBJ_DIR   = obj

# Must come AFTER OBJ_DIR is defined - this expands it. Defining it up
# with the other VALIDATION_* switches (before OBJ_DIR exists) silently
# produced "/assets/wiki_stress_page.o" with an empty prefix, and make
# then failed with "No rule to make target '/assets/wiki_stress_page.o'".
ifeq ($(VALIDATION_HTML_STRESS),0)
