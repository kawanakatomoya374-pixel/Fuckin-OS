	python3 tools/gen_cos_program.py --in $< --out $@ --symbol cos_craft_elf
# The Launcher (the former Craft icon): tabs Craft / mc-classic-c, userland/programs/launcher. The games it starts are files in /apps/minecraft
# (cos_system_layout.c): Craft.c-os above, and one program per version of mc-classic-c (github.com/degradka/mc-classic-c, GPL-3.0) built from
# userland/third_party/mc-classic-c by tools/mc_build.sh on top of the CPU renderer userland/programs/mcclassic (see docs/MC_CLASSIC.md).
# Linux GUI viewer (the Launcher's Linux tab): an RFB client for the X server the Linux layer runs (docs/LINUX_COMPAT.md)
# cos-xdrop: drops a file on an X window (XDND over the raw X11 protocol, no libraries; tools/xdrop/xdrop.c). linuxgui.c-os carries it and puts it into /linux when a file is dropped on its window.
$(BUILD_DIR)/cos-xdrop: tools/xdrop/xdrop.c | $(BUILD_DIR)
	$(CC) -O2 -fPIE -pie -nostdlib -ffreestanding -fno-builtin -fno-tree-loop-distribute-patterns -fno-stack-protector -fno-asynchronous-unwind-tables -Wl,-z,norelro -Wl,--build-id=none -Wl,--no-dynamic-linker -Wl,-e,_start -o $@ $<
# cos-wm: the tiny window manager that fills the X screen with the program (tools/xwm/xwm.c); started by the script linuxgui writes
$(BUILD_DIR)/cos-wm: tools/xwm/xwm.c | $(BUILD_DIR)
