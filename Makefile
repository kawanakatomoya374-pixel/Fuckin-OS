# ---- Compiler flags (optimized 64-bit freestanding) ----
# A dedicated validation image may enable the in-guest HTTP/2+Brotli smoke
# worker. Production/normal Secure Boot artifacts remain at 0 by default.
HTTP_RUNTIME_SMOKE ?= 0
# Loads the storage-backed local QuickJS document as the Browser start page in
# validation-only media. Normal artifacts remain at 0.
BROWSER_FILE_SMOKE ?= 0

# The boot-time HTML/CSS/DOM/layout stress test (see kernel.c's
# COS_VALIDATION_HTML_STRESS). Its input asset,
# src/assets/wiki_stress_page.c, is a ~4.6 MB generated byte-array of a
# real Wikipedia article and is NOT kept in version control - regenerate
# it with tools/gen_stress_asset.sh.
#
# The object is therefore linked in ONLY when the test is enabled.
# Listing it unconditionally made an ordinary `make` fail outright with
# "No rule to make target 'src/assets/wiki_stress_page.c'" on any tree
# that did not happen to have the generated file sitting there - which
# is every fresh checkout.
VALIDATION_HTML_STRESS ?= 0
# When BROWSER_FILE_SMOKE=1, tests may override this with any public HTTPS URL
# (for example https://www.google.com/) without changing browser source code.
BROWSER_SMOKE_START_URL ?= file:///browser/index.html
# track_flags(stamp, value): keeps a file whose content is `value`, rewriting it (and so bumping its mtime)
# only when the value changes. Objects that depend on the stamp are rebuilt exactly when a flag they use
# changed - make itself does not notice command-line variable changes.
define track_flags
$(shell mkdir -p $(dir $(1)))$(file >$(1).new,$(2))$(shell cmp -s $(1).new $(1) || cp $(1).new $(1))
endef

