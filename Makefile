# Generated C/C++ header dependencies.  Every compilation rule already uses
# CFLAGS or CXXFLAGS, so -MMD -MP above writes a sibling .d file for each
# object. Missing files are intentionally ignored on the first incremental
# build; later structural-header edits rebuild all affected objects instead of
# retaining incompatible layouts.
-include $(OBJS:.o=.d)

# ---- Build reproducibility helper (課題整理.md 2.4対応) ----
# `make check` はビルドを実行し、ログを保存した上で
# エラー・警告の有無を機械的に判定する。CIが無い状態でも、
# 最低限「ビルドが壊れていないか」を毎回同じ手順で確認できるようにする。
BUILD_LOG = build_check.log

.PHONY: trust-store
# The BearSSL trust anchor set (src/kernel/drivers/generated/
# bearssl_system_trust_anchors.inc) is a generated artifact checked into the
# tree, NOT regenerated by an ordinary build - baking the build host's live CA
# bundle into every build would make builds depend on host state and break
# reproducibility/offline builds. That tradeoff means it goes stale silently:
# it was found nine months out of date (121 of 150 current roots; missing
# DigiCert Global Root CA, GlobalSign Root CA, Baltimore CyberTrust Root, GTS
# Root R2 and others actually in use on the web), which is exactly the kind of
# gap that causes TLS failures against real, legitimate sites over time.
# Run this target explicitly before a release, or whenever TLS trust looks
# suspicious, to refresh it from the current host's CA bundle.
trust-store:
	@echo "Regenerating from tools/mozilla_ca_bundle.pem (a pinned Mozilla"
	@echo "root-program snapshot) - NOT this machine's ambient CA store."
	@echo "See tools/generate_bearssl_system_trust_store.py for why that"
	@echo "distinction matters (a build sandbox's own TLS-inspection CA was"
	@echo "found baked into a previous version of this file)."
	python3 tools/generate_bearssl_system_trust_store.py \
		--output src/kernel/drivers/generated/bearssl_system_trust_anchors.inc

.PHONY: check
check:
	@echo "[check] Running full build, logging to $(BUILD_LOG) ..."
	@$(MAKE) clean >/dev/null 2>&1 || true
	@( $(MAKE) 2>&1 | tee $(BUILD_LOG) ) ; status=$$? ; \
	if grep -qE "error:|Error [0-9]+" $(BUILD_LOG); then \
		echo "[check] FAILED: errors found in $(BUILD_LOG)"; \
		exit 1; \
	elif [ $$status -ne 0 ]; then \
		echo "[check] FAILED: make exited with status $$status (see $(BUILD_LOG))"; \
		exit 1; \
	else \
		warn_count=$$(grep -cE "warning:" $(BUILD_LOG) || true); \
		echo "[check] OK: build succeeded ($$warn_count warnings, see $(BUILD_LOG))"; \
	fi
obj_userland += tcc_app.o

# ============================================================================
# Embedded .c-os / .c-osll validation programs
# ----------------------------------------------------------------------------
# userspace_demo.c embeds ~27 small ring3 test programs (argv handling, mmap,
# signals, spawn/waitpid, cross-library relocation, and Test.c-os itself) as
# C byte arrays, via headers generated at build time from the ALREADY-BUILT
# binaries checked into validation/cos_programs/ - the same asset-embedding
# approach already used for src/assets/*.c (icons, sample media), just applied
# to .c-os binaries instead of images.
#
# This was a REAL, severe gap: these headers were previously generated by hand
# (running tools/gen_cos_program.py directly) during development and never
# committed or given a Makefile rule. A fresh checkout - including the exact
# ISO a user builds themselves - had no way to produce them, so `make` failed
# immediately on the first file that #included one:
#   fatal error: cos_hello_elf.h: No such file or directory
# Found by actually running a clean `make clean && make` from scratch rather
# than trusting the incremental builds used throughout development, which never
# deleted these headers and so never exposed the missing rule.
#
# Explicit per-file rules rather than one pattern rule: the source basename
# does not always match the symbol name (argvtest.c-os -> cos_argv_elf, not
# cos_argvtest_elf; Test.c-os capitalized to match the real shipped filename),
# so a generic %-pattern would either miss files or require the same amount of
# exception-listing anyway. Explicit is no larger and cannot silently mismatch.
VALIDATION_PROG_DIR := validation/cos_programs
VALIDATION_HEADERS :=

VALIDATION_HEADERS += $(BUILD_DIR)/cos_argv_elf.h
$(BUILD_DIR)/cos_argv_elf.h: $(VALIDATION_PROG_DIR)/argvtest.c-os tools/gen_cos_program.py | $(BUILD_DIR)
	@mkdir -p $(BUILD_DIR)
	python3 tools/gen_cos_program.py --in $(VALIDATION_PROG_DIR)/argvtest.c-os --out $(BUILD_DIR)/cos_argv_elf.h --symbol cos_argv_elf

VALIDATION_HEADERS += $(BUILD_DIR)/cos_childexit_elf.h
$(BUILD_DIR)/cos_childexit_elf.h: $(VALIDATION_PROG_DIR)/childexit.c-os tools/gen_cos_program.py | $(BUILD_DIR)
	@mkdir -p $(BUILD_DIR)
