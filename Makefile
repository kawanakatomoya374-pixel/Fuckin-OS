# The in-kernel dynamic linker. Separate from cos_elf.o on purpose: the
# loader maps and relocates ONE object and has no opinion about where
# dependencies come from, while this one reads the filesystem, owns the
# per-process namespace table and decides load order. Keeping the split
# is what lets the loader be tested on its own against a simulated MMU
# (see validation/elfloader).
$(OBJ_DIR)/kernel/cos_elf_link.o: $(SRCROOT)/kernel/cos_elf_link.c | $(OBJ_DIR)
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@
$(OBJ_DIR)/kernel/cos_pcache.o: $(SRCROOT)/kernel/cos_pcache.c | $(OBJ_DIR)
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

