# A real Wikipedia article, embedded for the boot-time HTML/CSS/DOM/
# layout stress test (COS_VALIDATION_HTML_STRESS in kernel.c). -O0
# override: this is a ~745KB byte-array initializer, and -O2 makes gcc
# spend a genuinely long time constant-folding an array this large for
# no benefit - it is opaque data, not code to optimize.
$(OBJ_DIR)/assets/wiki_stress_page.o: $(SRCROOT)/assets/wiki_stress_page.c | $(OBJ_DIR)
	mkdir -p $(dir $@)
	$(CC) $(filter-out -O2,$(CFLAGS)) -O0 $(INCLUDES) -c $< -o $@

